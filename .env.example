# ============================================
# ECOMMERCE PLATFORM ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in values
# ============================================

# NODE
NODE_ENV=development

# ── FRONTEND (apps/web) ──────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── BACKEND (apps/api) ───────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/ecommerce
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ecommerce
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_SSL=false

# JWT
JWT_SECRET=change_this_to_a_secure_random_string_min_32_chars
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=change_this_to_another_secure_random_string
REFRESH_TOKEN_EXPIRY=30d

# API
API_PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# ── SANITY CMS ───────────────────────────────
SANITY_PROJECT_ID=your_sanity_project_id
SANITY_DATASET=production
SANITY_API_TOKEN=skxxx
SANITY_WEBHOOK_SECRET=your_webhook_secret

# ── STRIPE ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── MEDUSA ───────────────────────────────────
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_ADMIN_URL=http://localhost:7001
MEDUSA_API_KEY=xxx

# ── REDIS ────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── EMAIL ────────────────────────────────────
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=SG.xxx
EMAIL_FROM=noreply@yourstore.com
EMAIL_FROM_NAME=Your Store

# ── ADMIN DASHBOARD (apps/admin) ─────────────
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3001
ADMIN_SECRET=change_this_admin_secret

# ── LOGGING ──────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── RATE LIMITING ────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
