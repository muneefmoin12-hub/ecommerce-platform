# Medusa Commerce Engine — Environment Variables
# Copy to .env and fill in real values

# ── Server ────────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:9000

# ── Database ─────────────────────────────────────────────────────────────────
MEDUSA_DATABASE_URL=postgresql://postgres:password@localhost:5432/medusa_db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth Secrets (change in production!) ──────────────────────────────────────
JWT_SECRET=supersecret-change-in-production
COOKIE_SECRET=supersecret-change-in-production

# ── CORS ─────────────────────────────────────────────────────────────────────
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:3002
AUTH_CORS=http://localhost:3000,http://localhost:3002

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Admin User (for initial seed) ────────────────────────────────────────────
MEDUSA_ADMIN_EMAIL=admin@store.com
MEDUSA_ADMIN_PASSWORD=Admin@12345
